# Application Basics
APP_NAME="OfficeHub SaaS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://api.yourdomain.com
FRONTEND_URL=https://app.yourdomain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ==============================================================================
# cPanel Shared Hosting Database Configuration (MySQL / MariaDB)
# ==============================================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_officemanagement
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD="YourStrongDatabasePasswordHere"
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ==============================================================================
# Drivers - Strictly Shared Hosting Safe (NO Redis / NO Supervisor)
# ==============================================================================
# Database queue processed via cron every minute:
QUEUE_CONNECTION=database

# Database or file cache:
CACHE_STORE=database
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=warning

# ==============================================================================
# Storage & Media Disk (Default: local private, R2 ready)
# ==============================================================================
# Default local storage is kept OUTSIDE web root at storage/app/private
# Files are served via authorized controller routes (NO storage:link required)
MEDIA_DISK=local

# When switching to Cloudflare R2 / S3 later, set:
# MEDIA_DISK=r2
# R2_ACCESS_KEY_ID=your-r2-access-key
# R2_SECRET_ACCESS_KEY=your-r2-secret-key
# R2_BUCKET=your-bucket-name
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_USE_PATH_STYLE_ENDPOINT=true

# ==============================================================================
# cPanel Mailbox SMTP Configuration
# ==============================================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.yourdomain.com
MAIL_PORT=465
MAIL_USERNAME=notifications@yourdomain.com
MAIL_PASSWORD="YourMailboxPassword"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="notifications@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"

# Throttle emails to respect cPanel hourly sending limits (e.g., 200 emails/hour)
MAIL_THROTTLE_PER_MINUTE=20

# ==============================================================================
# Platform Super Admin Initial Credentials (Used by Seeder)
# ==============================================================================
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_EMAIL=superadmin@platform.local
SUPER_ADMIN_PASSWORD="ChangeThisPasswordImmediately123!"

# ==============================================================================
# Biometric Device Integration Settings
# ==============================================================================
DEVICE_PUNCH_DEBOUNCE_SECONDS=60
DEVICE_MAX_BATCH_PUNCHES=500
